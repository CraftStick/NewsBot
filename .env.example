# Copy: cp .env.example .env
# Do not commit secrets. On VPS: /opt/treesheild-newsbot/.env (chmod 600)
# Скопируйте: cp .env.example .env — не коммитьте секреты

# --- Telegram ---
# Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your chat id: /start the bot → https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_PREVIEW_CHAT_ID=

# --- Google Gemini ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Запасной ключ (из другого проекта Google): включается при дневной квоте основного
GEMINI_API_KEY_BACKUP=
# GEMINI_MODEL_BACKUP=gemini-3.1-flash-lite  # у новых проектов нет моделей 2.5
GEMINI_MODEL=gemini-2.5-flash
# Запасная модель при перегрузке (503); off — отключить
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# --- Schedule ---
TZ=Europe/Moscow
# 5 fields: minute hour day month weekday (5 = Friday)
CRON_SCHEDULE=0 18 * * 5

# --- Media ---
# Картинка-шапка вшита в бинарник и шлётся с дайджестом в подписи к фото.
# Выключить (только текст): MEDIA_TYPE=none
MEDIA_TYPE=photo
# Журнал запусков (SQLite); по умолчанию digest.db рядом с бинарником
# DIGEST_DB=

# Юзербот: кнопка «Опубликовать в канал» под превью одиночного поста (пусто = без кнопки)
# PUBLISH_CMD=/opt/treesheild-newsbot/publisher/venv/bin/python /opt/treesheild-newsbot/publisher/publish.py
# PUB_SESSION=/opt/treesheild-newsbot/publisher/pub
# PUB_CHANNEL=@treeshieldoffical
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=

